\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Fitted streamlines for one cleaned dataset. The diagnostic question is whether the fitted local NW field follows the same local circular flow as the observed line segments. The smoother can bend locally because $\hat  \alpha (z)$ is learned from nearby observations through the kernel weights.}}{14}{figure.11}\protected@file@percent }
\newlabel{fig:streamline-example-one}{{11}{14}{Fitted streamlines for one cleaned dataset. The diagnostic question is whether the fitted local NW field follows the same local circular flow as the observed line segments. The smoother can bend locally because $\hat \alpha (z)$ is learned from nearby observations through the kernel weights}{figure.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces A second fitted-streamline example from a dataset with heavier cleaning. The visual comparison should be read together with the raw-clean study in Figure~\ref {fig:data-cleaning-study}: when peripheral segments are removed, the fitted field is evaluated on the central region where the circular line pattern is the object of study.}}{14}{figure.12}\protected@file@percent }
\newlabel{fig:streamline-example-two}{{12}{14}{A second fitted-streamline example from a dataset with heavier cleaning. The visual comparison should be read together with the raw-clean study in Figure~\ref {fig:data-cleaning-study}: when peripheral segments are removed, the fitted field is evaluated on the central region where the circular line pattern is the object of study}{figure.12}{}}

\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Quantitative data study comparing the uncleaned and cleaned files. The top-left panel plots $n_j^{\mathrm  {raw}}$ against $n_j^{\mathrm  {clean}}$; points on the dashed line would mean no pruning. The top-right panel shows the retention ratio. The bottom-left panel identifies the datasets for which the central ROI removes the most segments. The bottom-right panel compares the raw and cleaned sample-size distributions.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:data-cleaning-study}{{1}{2}{Quantitative data study comparing the uncleaned and cleaned files. The top-left panel plots $n_j^{\mathrm {raw}}$ against $n_j^{\mathrm {clean}}$; points on the dashed line would mean no pruning. The top-right panel shows the retention ratio. The bottom-left panel identifies the datasets for which the central ROI removes the most segments. The bottom-right panel compares the raw and cleaned sample-size distributions}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Representative raw and cleaned line fields. The left column shows the uncleaned segment set, and the right column shows the central-ROI subset used in the model comparison. These plots visually justify the data-design statement that cleaning removes peripheral fragments while retaining the central circular line field.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:cleaning-examples}{{2}{3}{Representative raw and cleaned line fields. The left column shows the uncleaned segment set, and the right column shows the central-ROI subset used in the model comparison. These plots visually justify the data-design statement that cleaning removes peripheral fragments while retaining the central circular line field}{figure.2}{}}
